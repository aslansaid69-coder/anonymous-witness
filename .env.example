# Hosted pooled Postgres URL; use a direct URL only for Alembic commands.
DATABASE_URL=
# Base64-encoded random 32-byte AES key and independent random pepper (>=32 chars).
ENCRYPTION_KEY=
TOKEN_PEPPER=
ALLOWED_ORIGIN=https://anonymous-witness.vercel.app
ALLOWED_ORIGINS=
SECURE_COOKIES=true
SESSION_MINUTES=30
# One-time seed. A password change is required on first sign-in.
OWNER_USERNAME=school.owner
OWNER_PASSWORD=
# Hosted private Vercel Blob. On Vercel, linked-store OIDC is preferred.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Web Push P-256 keys, base64url; private key is 32 raw bytes, public key is 65 bytes.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=https://anonymous-witness.vercel.app
CRON_SECRET=
