# Run python3 setup.py to generate unique values in .env. Never reuse placeholders.
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
TOKEN_PEPPER=
DEMO_PASSWORD=
SECURE_COOKIES=false
ALLOWED_ORIGIN=http://localhost:8080
SESSION_MINUTES=30

ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Hosted Vercel + Neon uses database; Docker defaults to filesystem.
STORAGE_BACKEND=filesystem
